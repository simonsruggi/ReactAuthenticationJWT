# Copia questo file in backend/.env e inserisci i tuoi valori.
# backend/.env è ignorato da git e non va mai committato.

MONGODB_URI=mongodb://localhost:27017/your-database

# Genera un valore lungo e casuale, per esempio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Durata dei token (formato di jsonwebtoken: 15m, 1h, 7d...)
JWT_EXPIRES_IN=1h

# Origini autorizzate a chiamare l'API, separate da virgola.
CORS_ORIGIN=http://localhost:3000
